<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- NOT the F# default in Debug. Without it fsc emits no `tail.` prefix and the fault vanishes. -->
    <Tailcalls>true</Tailcalls>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Prim.fs" />
  </ItemGroup>
</Project>
